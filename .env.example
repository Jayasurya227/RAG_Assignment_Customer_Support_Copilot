# ========================================================
# Dandes Electronics Customer Support Copilot - Configuration
# ========================================================

# OpenAI API Key (or GitHub Models token)
OPENAI_API_KEY=your_api_key_or_github_token_here

# Optional: Custom endpoint (leave commented for official OpenAI api.openai.com)
# For GitHub Models free tier: https://models.inference.ai.azure.com
# OPENAI_BASE_URL=https://models.inference.ai.azure.com

# Models (as recommended in Section 1.4, configurable)
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
